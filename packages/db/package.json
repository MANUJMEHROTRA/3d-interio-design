{
  "name": "@layoutcraft/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, client singleton and seed data.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "node --experimental-strip-types src/seed.ts"
  },
  "prisma": { "schema": "prisma/schema.prisma" },
  "dependencies": {
    "@prisma/client": "6.3.1"
  },
  "devDependencies": {
    "prisma": "6.3.1",
    "typescript": "5.7.3"
  }
}
