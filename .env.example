# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is committed.
# ---------------------------------------------------------------------------

# Postgres. The docker-compose service publishes on 5434 so it does not clash
# with any Postgres you already run on 5432.
DATABASE_URL="postgresql://layoutcraft:layoutcraft@localhost:5434/layoutcraft"

# Public base URL. Used for Stripe redirects and the share links you send
# clients, so it must be the address they can actually reach.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stripe. Billing is disabled and the app says so until these are set.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=""

# One Stripe price per plan and interval. Create them as recurring, per-seat
# (quantity) prices in your Stripe dashboard, then paste the price ids.
STRIPE_PRICE_SOLO_MONTH=""
STRIPE_PRICE_SOLO_YEAR=""
STRIPE_PRICE_STUDIO_MONTH=""
STRIPE_PRICE_STUDIO_YEAR=""
STRIPE_PRICE_PRACTICE_MONTH=""
STRIPE_PRICE_PRACTICE_YEAR=""
